{
  "name": "compound-engineering-orca",
  "version": "3.30.5",
  "description": "Compound Engineering skills plugin with optional Orca orchestration",
  "type": "module",
  "private": true,
  "main": "index.js",
  "pi": {
    "extensions": [
      "./.pi/extensions/compound-engineering.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "homepage": "https://github.com/ethras/compound-engineering-orca",
  "repository": "https://github.com/ethras/compound-engineering-orca",
  "scripts": {
    "codex:dev": "bun run scripts/codex-dev.ts",
    "dev": "bun run src/index.ts",
    "convert": "bun run src/index.ts convert",
    "cleanup": "bun run src/index.ts cleanup",
    "list": "bun run src/index.ts list",
    "cli:install": "bun run src/index.ts install",
    "test": "bun run scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "test:acpx-contract": "ACPX_CONTRACT=1 bun test tests/acpx-contract.test.ts",
    "acpx:bump": "bun run scripts/bump-acpx-pin.ts",
    "test:skill-guards": "bun run scripts/run-tests.ts skill-conventions codex-skill-prompt-budget repo-local-ce-skill-work contract",
    "test:skill-eval-cell": "bun tests/skill-eval-cell/run.ts",
    "test:skill-eval-pack": "bun tests/skill-eval-cell/pack.ts",
    "test:skill-eval-judge": "bun tests/skill-eval-cell/judge.ts",
    "plugin:validate": "claude plugin validate --strict .claude-plugin/marketplace.json && claude plugin validate --strict .claude-plugin/plugin.json",
    "orca:generate-bundles": "bun integrations/orca/generate-skill-bundles.mjs",
    "orca:check-bundles": "bun integrations/orca/generate-skill-bundles.mjs --check",
    "orca:upstream-check": "bun integrations/orca/upstream-parity.mjs",
    "orca:version": "bun integrations/orca/version.mjs",
    "release:preview": "bun run scripts/release/preview.ts",
    "release:sync-metadata": "bun run scripts/release/sync-metadata.ts --write",
    "release:validate": "bun run scripts/release/validate.ts",
    "site:build": "cd site && bundle exec jekyll build --strict_front_matter",
    "site:serve": "cd site && bundle exec jekyll serve --livereload",
    "site:test": "cd site && bundle exec rake test",
    "site:check": "cd site && LC_ALL=C.UTF-8 bundle exec htmlproofer _site --disable-external --allow-missing-href --no-enforce-https --swap-urls '^/compound-engineering/:/'"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9"
  }
}
